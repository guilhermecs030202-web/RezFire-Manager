# ==============================================================================
# RezFire Manager - Variáveis de Ambiente (Docker & Local)
# ==============================================================================

# Porta da Aplicação
PORT=3001

# Banco de Dados MySQL
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=RezFireDB

# Segurança e Autenticação
JWT_SECRET=rezfire_super_secret_jwt_key_change_in_production
COOKIE_SECRET=rezfire_cookie_secret_key

# Mercado Livre OAuth 2.0 (Opcional - preencher quando registrar o app no ML Developers)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:3001/api/ml/callback

# Diretório de Uploads
UPLOAD_DIR=/app/backend/uploads/certificados

