# Porta da API do RezFire Manager
PORT=3001

# Conexão com o Banco de Dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=RezFireDB

# Segurança e Sessão
JWT_SECRET=rezfire_super_secret_jwt_key_change_in_production
COOKIE_SECRET=rezfire_cookie_secret_key

# Mercado Livre OAuth 2.0 (Preencher quando registrar a aplicação no ML Developers)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:3001/api/ml/callback

# Armazenamento de Arquivos
UPLOAD_DIR=./uploads/certificados
FISCAL_ENCRYPTION_KEY=
FISCAL_VAULT_DIR=./uploads/fiscal-vault
FISCAL_XML_ARCHIVE_DIR=./uploads/fiscal-xmls

# Comunicação SEFAZ NF-e v4.00 (Stories 33d/33f/33g: simulado | sefaz_soap)
SEFAZ_MODO_TRANSPORTE=simulado
SEFAZ_TIMEOUT_MS=15000
SEFAZ_PRAZO_CANCELAMENTO_HORAS=24
SEFAZ_PRAZO_CANCELAMENTO_EXTEMPORANEO_HORAS=480
SEFAZ_PRAZO_CCE_DIAS=30
FISCAL_ALERTA_CERTIFICADO_DIAS=30

